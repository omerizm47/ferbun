{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": ".selfcheck",
    "types": []
  },
  "include": [
    "tools/**/*.ts",
    "src/data/**/*.ts",
    "src/stores/progressMigration.ts",
    "src/utils/answers.ts",
    "src/utils/badges.ts",
    "src/i18n/types.ts"
  ]
}
